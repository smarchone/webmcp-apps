{
  "name": "webmcp-context-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown editor where you comment on highlighted text and a Claude Code session addresses the comments through WebMCP",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build:vendor": "esbuild vendor-src/tiptap-entry.js --bundle --format=esm --minify --outfile=app/vendor/tiptap.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "esbuild": "^0.28.2"
  }
}
